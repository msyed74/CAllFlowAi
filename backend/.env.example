# ------------------------------------------------------------------------------
# CALLFLOW AI - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ------------------------------------------------------------------------------

# Application & Server
APP_ENV=development
APP_NAME="CallFlow AI"
DEBUG=true
PORT=8000
HOST=0.0.0.0
BASE_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
JWT_SECRET="cf_dev_secret_0123456789abcdef0123456789abcdef0123456789abcdef01234567"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_MASTER_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Database (PostgreSQL asyncpg by default, or sqlite+aiosqlite for local lightweight dev/test)
DATABASE_URL="postgresql+asyncpg://callflow_user:callflow_pass@localhost:5432/callflow_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis In-Memory State & Pub/Sub
REDIS_URL="redis://:callflow_redis_pass@localhost:6379/0"
REDIS_POOL_SIZE=50

# OpenAI Voice & Realtime Model
OPENAI_API_KEY="sk-proj-placeholder-key-for-dev"
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview-2024-10-01"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_SUMMARY_MODEL="gpt-4o-mini"
OPENAI_DEFAULT_VOICE="alloy"

# Twilio Telephony & Media Streams
TWILIO_ACCOUNT_SID="ACplaceholder0000000000000000000000"
TWILIO_AUTH_TOKEN="placeholder_twilio_auth_token"
TWILIO_DEFAULT_PHONE_NUMBER="+18005550199"
TWILIO_MEDIA_STREAM_WS_URL="wss://localhost:8000/ws/media-stream"

# Qdrant Vector Engine
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="callflow_knowledge_base"

# S3 / MinIO Object Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_REGION_NAME="us-east-1"
S3_BUCKET_NAME="callflow-recordings"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"

# Automation (n8n)
N8N_WEBHOOK_BASE_URL="http://localhost:5678/webhook"
N8N_API_KEY="callflow_n8n_secret_token"

# Diagnostics & Logging
LOG_LEVEL="INFO"
